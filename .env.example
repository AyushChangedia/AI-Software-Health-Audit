# ---------------------------------------------------------------------------
# Sentinel configuration
#
# Every variable here is OPTIONAL. Sentinel boots with an empty environment
# and runs a real analysis; what you set here is which capabilities are on.
# `GET /api/health` reports exactly what is enabled on a running instance.
# ---------------------------------------------------------------------------

# Absolute origin. Used for share links, OpenGraph metadata and OAuth callbacks.
APP_URL=http://localhost:3000

# Signs the anonymous workspace cookie. Without it, sessions do not survive a
# restart. Generate one with: openssl rand -base64 32
SENTINEL_SECRET=

# ---------------------------------------------------------------------------
# Persistence — optional
#
# Unset: an in-process store, mirrored to .sentinel/store.json in development.
# Perfect for one instance; scan state is not shared between instances.
# Set: PostgreSQL. Requires `npm install pg`. Schema in db/migrations.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinel

# ---------------------------------------------------------------------------
# Queue — optional
#
# Unset: scans run in the web process with bounded concurrency.
# Set: scans are dispatched to `npm run worker`, so repository analysis never
# runs in the process that serves requests. Requires `npm install bullmq ioredis`.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# GitHub — optional
#
# GITHUB_TOKEN raises the read-only API limit from 60 to 5,000 requests/hour.
# A classic token with NO scopes is enough for public repositories.
# The OAuth pair enables sign-in for private repositories.
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI provider — optional
#
# With no provider, agents run their deterministic paths and the report says
# so in the "What ran" panel. With one, the model enriches findings the static
# analysis already located and adjudicates the validator's hardest calls.
#
# AI_PROVIDER: anthropic | openai | google | openai-compatible
# AI_MODEL is required when AI_PROVIDER is set — pick the model you want
# Sentinel to reason with rather than inheriting a default that may have moved.
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=            # required for openai-compatible endpoints
# AI_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Analysis guard rails
#
# Repository archives are untrusted input. These are the caps that keep a
# hostile or simply enormous repository from exhausting the host.
# ---------------------------------------------------------------------------
# SCAN_MAX_FILES=6000
# SCAN_MAX_FILE_BYTES=512000
# SCAN_MAX_TOTAL_BYTES=80000000
# SCAN_TIMEOUT_MS=180000
# SCAN_CONCURRENCY=2

# Presentation pacing for the live agent view, in milliseconds. Analysis of a
# small repository finishes faster than a human can read; this slows the
# *display* of real work. Set to 0 to stream as fast as the engine goes.
# SCAN_PACE_MS=170

# Per-IP scan creations allowed per hour.
# RATE_LIMIT_SCANS_PER_HOUR=20

# Refuse live repositories entirely and serve only the bundled demo. Useful
# for a public instance you do not want used as a free scanning service.
# SENTINEL_DEMO_ONLY=false

# debug | info | warn | error
# LOG_LEVEL=info
